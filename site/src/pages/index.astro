---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Education from "../components/Education.astro";
import Certs from "../components/Certs.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Zhanbolot Eraliev"
  description="AWS-certified cloud support associate candidate, graduating 2028, available Summer 2027. Networking, Linux, and log-driven troubleshooting."
>
  <div class="page">
    <Hero />
    <Intro />
    <Education />
    <Certs />
    <Experience />
    <Projects />
    <Footer />
  </div>
</Layout>

<style>
  .page {
    margin-inline: auto;
    padding-inline: 1.5rem;
    max-width: 40rem;
  }
</style>
