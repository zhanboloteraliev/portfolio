---
const jobs = [
  {
    name: "Kundooku",
    url: "https://kundooku.com",
    logo: "/assets/logos/kundooku.svg",
    shine: true,
    role: "Founder & Sole Engineer",
    description:
      "Architected and operate a live production platform on Cloudflare's global cloud infrastructure (serverless compute, edge CDN, DNS), owning everything from deployment pipeline to real-user incident response.",
  },
];
---

<section id="experience" class="experience">
  <h2>Experience</h2>
  <div class="entries">
    {
      jobs.map((job) => (
        <a
          href={job.url}
          target="_blank"
          rel="noopener noreferrer"
          class="entry"
        >
          <img
            src={job.logo}
            alt=""
            width="52"
            height="52"
            class="logo"
            loading="lazy"
          />
          <div class="entry-body">
            <div class="entry-head">
              <h3 class={job.shine ? "shine" : undefined}>{job.name}</h3>
            </div>
            <p>
              <strong>{job.role}</strong> — {job.description}
            </p>
            <span class="sr-only">
              — visit {job.name} (opens in new tab)
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .experience {
    padding-block: 2rem;
    max-width: 40rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-route);
    opacity: 0.55;
    margin: 0 0 1.25rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 1.1rem;
    text-decoration: none;
    color: inherit;
  }

  .logo {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .entry-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0;
    color: var(--color-ink);
  }

  p {
    font-size: 1rem;
    line-height: 1.55;
    margin: 0.35rem 0 0;
  }

  .shine {
    color: var(--color-route);
    background-image: linear-gradient(
      100deg,
      var(--color-route) 0%,
      var(--color-route) 40%,
      #8fb3ff 50%,
      var(--color-route) 60%,
      var(--color-route) 100%
    );
    background-size: 300% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 3.5s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
</style>
