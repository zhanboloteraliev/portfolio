---
---

<section id="profile" class="hero">
  <div class="reveal terminal" style="--delay:0">
    <div class="terminal-titlebar" aria-hidden="true">
      <div class="traffic-lights">
        <span class="light light-red"></span>
        <span class="light light-yellow"></span>
        <span class="light light-green"></span>
      </div>
      <span class="terminal-title">bash</span>
    </div>
    <div class="terminal-body">
      <p class="terminal-line" data-line>
        <span class="prompt">~$</span><span class="cmd" data-typewriter>whoami</span>
      </p>
      <h1 class="terminal-line output" data-line>
        <span class="name" data-typewriter>zhanbolot (john) eraliev</span>
        <span class="loc" data-typewriter>Greater Seattle Area, WA</span>
      </h1>
      <p class="terminal-line role-cmd" data-line>
        <span class="prompt">~$</span><span class="cmd" data-typewriter>cat role.txt</span>
      </p>
      <p class="terminal-line role-output" data-line data-typewriter>Cloud Support Associate · Summer 2027</p>
      <p class="terminal-line" data-line>
        <span class="prompt">~$</span><span class="cursor"></span>
      </p>
    </div>
  </div>

  <script is:inline src="/scripts/whoami.js" defer></script>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vh, 6rem) 1rem;
    max-width: 40rem;
  }

  .terminal {
    background: #1b2b38;
    border: 1px solid #33475a;
    border-radius: 0.6rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 8px 30px -12px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .terminal-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid #33475a;
  }

  .traffic-lights {
    display: flex;
    gap: 0.45rem;
  }

  .light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .light-red {
    background: #ff5f56;
  }

  .light-yellow {
    background: #ffbd2e;
  }

  .light-green {
    background: #27c93f;
  }

  .terminal-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: #8996ac;
  }

  .terminal-body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .terminal-line {
    font-family: var(--font-mono);
    margin: 0;
  }

  .terminal-line.output {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1.25rem, 4.5vw, 1.75rem);
    line-height: 1.15;
    color: #33ff66;
  }

  .prompt {
    color: #33ff66;
    font-size: 0.9375rem;
    margin-right: 0.5em;
  }

  .cmd {
    color: #33ff66;
    font-size: 0.9375rem;
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.15em;
    background: #33ff66;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
  }

  .loc {
    display: block;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: #33ff66;
    margin-top: 0.5rem;
  }

  .role-cmd {
    margin-top: 0.9rem;
  }

  .role-output {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.9375rem;
    color: #33ff66;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    line-height: 1.1;
    margin: 0 0 0.9rem;
  }

  .reveal {
    opacity: 0;
    animation: fade-rise 320ms ease-out calc(var(--delay) * 60ms) forwards;
  }

  @keyframes fade-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
