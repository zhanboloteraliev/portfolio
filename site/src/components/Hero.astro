---
---

<section id="profile" class="hero">
  <div class="reveal terminal" style="--delay:0">
    <div class="terminal-titlebar" aria-hidden="true">
      <div class="traffic-lights">
        <span class="light light-red"></span>
        <span class="light light-yellow"></span>
        <span class="light light-green"></span>
      </div>
      <span class="terminal-title">bash</span>
    </div>
    <div class="terminal-body">
      <p class="terminal-line">
        <span class="prompt">$</span><span class="cmd" data-typewriter>whoami</span><span class="cursor"></span>
      </p>
      <h1 class="terminal-line output">
        Zhanbolot Eraliev
        <span class="loc">Woodinville, WA</span>
      </h1>
    </div>
  </div>

  <script is:inline src="/scripts/whoami.js" defer></script>

  <p class="reveal role" style="--delay:1">
    Cloud Support Associate &mdash; Summer 2027 internship
  </p>
  <p class="reveal credentials" style="--delay:2">
    AWS Certified Solutions Architect &ndash; Associate. BS Computer Science,
    graduating 2028.
  </p>
  <p class="reveal tagline" style="--delay:2">
    I troubleshoot infrastructure from the packet up.
  </p>

  <div class="reveal badges" style="--delay:3">
    <a
      href="https://www.credly.com/badges/f485fabc-4b43-4383-b4df-69ab72ca26cc"
      target="_blank"
      rel="noopener noreferrer"
      class="aws-badge"
    >
      <img
        src="/assets/badges/aws-saa.png"
        alt=""
        width="64"
        height="64"
        loading="eager"
      />
      <span class="aws-badge-text">
        <span class="status status-earned">Earned</span>
        AWS Solutions Architect &ndash; Associate
        <span class="sr-only">— verify on Credly (opens in new tab)</span>
      </span>
    </a>
  </div>

  <a class="reveal cta" style="--delay:4" href="/resume">View résumé →</a>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vh, 6rem) 3rem;
    max-width: 40rem;
  }

  .terminal {
    background: #1b2b38;
    border: 1px solid #33475a;
    border-radius: 0.6rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 8px 30px -12px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .terminal-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid #33475a;
  }

  .traffic-lights {
    display: flex;
    gap: 0.45rem;
  }

  .light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .light-red {
    background: #ff5f56;
  }

  .light-yellow {
    background: #ffbd2e;
  }

  .light-green {
    background: #27c93f;
  }

  .terminal-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: #8996ac;
  }

  .terminal-body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .terminal-line {
    font-family: var(--font-mono);
    margin: 0;
  }

  .terminal-line.output {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 5.5vw, 2.125rem);
    line-height: 1.15;
    color: #e6edf4;
  }

  .prompt {
    color: #33ff66;
    font-size: 0.9375rem;
    margin-right: 0.5em;
  }

  .cmd {
    color: #33ff66;
    font-size: 0.9375rem;
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.15em;
    background: #33ff66;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
  }

  .loc {
    display: block;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8996ac;
    margin-top: 0.5rem;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    line-height: 1.1;
    margin: 0 0 0.9rem;
  }

  .role {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 3.4vw, 1.375rem);
    line-height: 1.3;
    color: var(--color-route);
    margin: 0 0 0.6rem;
  }

  .credentials {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 0.35rem;
  }

  .tagline {
    font-size: 1rem;
    line-height: 1.5;
    opacity: 0.75;
    margin: 0 0 1.5rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .aws-badge {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.75rem 0.35rem 0.35rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .aws-badge:hover {
    border-color: var(--color-route);
  }

  .aws-badge img {
    width: 40px;
    height: 40px;
  }

  .aws-badge-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 1px;
  }

  .status-earned {
    color: var(--color-relay);
  }
  .status-earned::before {
    background: var(--color-relay);
  }

  .cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-route);
    text-decoration: none;
    border-bottom: 1.5px solid var(--color-route);
    padding-bottom: 0.15rem;
  }

  .cta:hover {
    opacity: 0.75;
  }

  .reveal {
    opacity: 0;
    animation: fade-rise 320ms ease-out calc(var(--delay) * 60ms) forwards;
  }

  @keyframes fade-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
