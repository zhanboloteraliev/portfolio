---
const certs = [
  {
    name: "AWS Certified Solutions Architect – Associate",
    href: "https://www.credly.com/badges/f485fabc-4b43-4383-b4df-69ab72ca26cc",
    status: "Earned",
    statusClass: "status-earned",
  },
  {
    name: "Microsoft Certified: Azure Administrator Associate (AZ-104)",
    href: null,
    status: "In progress",
    statusClass: "status-progress",
  },
];
---

<section id="certs" class="certs">
  <h2>Certifications</h2>
  <div class="entries">
    {
      certs.map((c) => (
        <div class="entry">
          <h3>
            {c.href ? (
              <a href={c.href} target="_blank" rel="noopener noreferrer">
                {c.name}
              </a>
            ) : (
              c.name
            )}
          </h3>
          <span class={`when ${c.statusClass}`}>{c.status}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .certs {
    padding-block: 2rem;
    max-width: 40rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 1.25rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .entry {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 0.9rem;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
  }

  h3 a:hover {
    border-color: var(--color-route);
    color: var(--color-route);
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .status-earned {
    color: var(--color-relay);
  }

  .status-progress {
    color: var(--color-flare);
  }
</style>
