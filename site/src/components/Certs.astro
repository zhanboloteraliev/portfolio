---
---

<section id="certs" class="certs">
  <h2>Certifications</h2>

  <div class="entries">
    <a
      href="https://www.credly.com/badges/f485fabc-4b43-4383-b4df-69ab72ca26cc"
      target="_blank"
      rel="noopener noreferrer"
      class="entry"
    >
      <img
        src="/assets/badges/aws-tile.webp"
        alt=""
        width="52"
        height="52"
        class="logo"
        loading="lazy"
      />
      <div class="entry-body">
        <div class="entry-head">
          <h3 class="shine">AWS Solutions Architect &ndash; Associate</h3>
          <span class="when">2026</span>
        </div>
        <span class="sr-only">— verify on Credly (opens in new tab)</span>
      </div>
    </a>

    <div class="entry">
      <img
        src="/assets/badges/ms-tile.png"
        alt=""
        width="52"
        height="52"
        class="logo"
        loading="lazy"
      />
      <div class="entry-body">
        <div class="entry-head">
          <h3>Microsoft Certified: Azure Fundamentals</h3>
          <span class="when status-progress">In progress</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .certs {
    padding-block: 2rem;
    max-width: 40rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-route);
    opacity: 0.55;
    margin: 0 0 1.25rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .logo {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .entry-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0;
    color: var(--color-ink);
  }

  .shine {
    color: var(--color-route);
    background-image: linear-gradient(
      100deg,
      var(--color-route) 0%,
      var(--color-route) 40%,
      #8fb3ff 50%,
      var(--color-route) 60%,
      var(--color-route) 100%
    );
    background-size: 300% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 3.5s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.55;
    white-space: nowrap;
    text-align: right;
  }

  .status-progress {
    color: var(--color-flare);
    opacity: 1;
  }
</style>
