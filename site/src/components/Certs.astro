---
const inProgress = [
  {
    name: "Microsoft Certified: Azure Administrator Associate (AZ-104)",
    status: "In progress",
    statusClass: "status-progress",
  },
];
---

<section id="certs" class="certs">
  <h2>Certifications</h2>

  <a
    href="https://www.credly.com/badges/f485fabc-4b43-4383-b4df-69ab72ca26cc"
    target="_blank"
    rel="noopener noreferrer"
    class="aws-badge"
  >
    <img
      src="/assets/badges/aws-tile.webp"
      alt=""
      width="64"
      height="64"
      loading="lazy"
    />
    <span class="aws-badge-text">
      AWS Solutions Architect &ndash; Associate
      <span class="sr-only">— verify on Credly (opens in new tab)</span>
    </span>
  </a>

  <div class="entries">
    {
      inProgress.map((c) => (
        <div class="entry">
          <h3>{c.name}</h3>
          <span class={`when ${c.statusClass}`}>{c.status}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .certs {
    padding-block: 2rem;
    max-width: 40rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-route);
    opacity: 0.55;
    margin: 0 0 1.25rem;
  }

  .aws-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-bottom: 0.9rem;
  }

  .aws-badge img {
    width: 52px;
    height: 52px;
    border-radius: 0.5rem;
  }

  .aws-badge-text {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: var(--color-route);
    background-image: linear-gradient(
      100deg,
      var(--color-route) 0%,
      var(--color-route) 40%,
      #8fb3ff 50%,
      var(--color-route) 60%,
      var(--color-route) 100%
    );
    background-size: 300% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 3.5s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .entry {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 0.9rem;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0;
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .status-progress {
    color: var(--color-flare);
  }
</style>
