---
const schools = [
  {
    name: "Central Washington University",
    logo: "/assets/logos/cwu.png",
    lines: ["Bachelor of Science, Computer Science"],
    badge: "Graduating 2028",
  },
  {
    name: "Lake Washington Institute of Technology",
    logo: "/assets/logos/lwtech.png",
    lines: ["AAS, Computer Science"],
    gpa: "GPA: 3.79 / 4.0",
    honors: "Magna Cum Laude",
  },
];
---

<section id="education" class="education">
  <h2>Education</h2>
  <div class="entries">
    {
      schools.map((s) => (
        <div class="entry">
          <img src={s.logo} alt="" width="44" height="44" class="logo" />
          <div class="entry-body">
            <h3>{s.name}</h3>
            {s.lines.map((line) => (
              <p>{line}</p>
            ))}
            {s.gpa && <p class="gpa">{s.gpa}</p>}
            {s.honors && <p class="honors">{s.honors}</p>}
            {s.badge && <span class="badge-shine">{s.badge}</span>}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .education {
    padding-block: 2rem;
    max-width: 40rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-route);
    margin: 0 0 1.25rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 1.1rem;
  }

  .logo {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  .entry-body {
    min-width: 0;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0 0 0.25rem;
  }

  p {
    font-size: 1rem;
    line-height: 1.55;
    margin: 0.2rem 0 0;
  }

  .gpa {
    font-weight: 700;
  }

  .honors {
    opacity: 0.75;
    font-style: italic;
  }

  .badge-shine {
    display: inline-block;
    margin-top: 0.3rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-route);
    background-image: linear-gradient(
      100deg,
      var(--color-route) 0%,
      var(--color-route) 40%,
      #8fb3ff 50%,
      var(--color-route) 60%,
      var(--color-route) 100%
    );
    background-size: 300% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 3.5s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
</style>
