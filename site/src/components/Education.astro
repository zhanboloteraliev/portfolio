---
const schools = [
  {
    name: "Central Washington University",
    logo: "/assets/logos/cwu.png",
    when: "Fall 2026 – 2028",
    detail: "BS, Computer Science (Lynnwood)",
  },
  {
    name: "Lake Washington Institute of Technology",
    logo: "/assets/logos/lwtech.png",
    when: "Transferred 2026",
    detail: "Computer Science, DTA Associate — Magna Cum Laude, 3.79 GPA",
  },
];
---

<section id="education" class="education">
  <h2>Education</h2>
  <div class="entries">
    {
      schools.map((s) => (
        <div class="entry">
          <img src={s.logo} alt="" width="40" height="40" class="logo" />
          <div class="entry-body">
            <div class="entry-head">
              <h3>{s.name}</h3>
              <span class="when">{s.when}</span>
            </div>
            <p>{s.detail}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .education {
    padding-block: 2rem;
    max-width: 40rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-route);
    margin: 0 0 1.25rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    display: flex;
    gap: 0.9rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 1.1rem;
  }

  .logo {
    flex-shrink: 0;
    border-radius: 0.375rem;
    object-fit: cover;
  }

  .entry-body {
    min-width: 0;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0;
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.6;
    white-space: nowrap;
  }

  p {
    font-size: 1rem;
    line-height: 1.55;
    margin: 0;
  }
</style>
