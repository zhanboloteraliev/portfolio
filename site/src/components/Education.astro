---
const schools = [
  {
    name: "Central Washington University",
    logo: "/assets/logos/cwu.png",
    when: "Fall 2026 – 2028",
    lines: ["Bachelor of Science, Computer Science (Lynnwood)"],
    badge: "Graduating 2028",
  },
  {
    name: "Lake Washington Institute of Technology",
    logo: "/assets/logos/lwtech.png",
    when: "Transferred 2026",
    lines: ["AAS, Computer Science"],
    gpa: "GPA: 3.79 / 4.0",
    honors: "Magna Cum Laude",
  },
];
---

<section id="education" class="education">
  <h2>Education</h2>
  <div class="entries">
    {
      schools.map((s) => (
        <div class="entry">
          <img src={s.logo} alt="" width="44" height="44" class="logo" />
          <div class="entry-body">
            <div class="entry-head">
              <h3>{s.name}</h3>
              <span class="when">{s.when}</span>
            </div>
            {s.lines.map((line) => (
              <p>{line}</p>
            ))}
            {s.gpa && <p class="gpa">{s.gpa}</p>}
            {s.honors && <p class="honors">{s.honors}</p>}
            {s.badge && <span class="badge-shine">{s.badge}</span>}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .education {
    padding-block: 2rem;
    max-width: 40rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-route);
    margin: 0 0 1.25rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 1.1rem;
  }

  .logo {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  .entry-body {
    min-width: 0;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0;
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.6;
    white-space: nowrap;
  }

  p {
    font-size: 1rem;
    line-height: 1.55;
    margin: 0.2rem 0 0;
  }

  .gpa {
    font-weight: 700;
  }

  .honors {
    opacity: 0.75;
    font-style: italic;
  }

  .badge-shine {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--color-route) 35%, transparent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-route);
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--color-route) 10%, transparent) 35%,
      color-mix(in srgb, var(--color-route) 40%, transparent) 50%,
      color-mix(in srgb, var(--color-route) 10%, transparent) 65%
    );
    background-size: 250% 100%;
    animation: shine 2.8s ease-in-out infinite;
  }

  @keyframes shine {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
</style>
