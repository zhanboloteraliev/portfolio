---
const schools = [
  {
    name: "Central Washington University",
    logo: "/assets/logos/cwu.png",
    when: "2026 – 2028",
    lines: ["Bachelor of Science, Computer Science · Minor in Mathematics"],
    badge: "Graduating 2028",
    badgeAnimated: true,
  },
  {
    name: "Lake Washington Institute of Technology",
    logo: "/assets/logos/lwtech.png",
    when: "2024 – 2026",
    lines: ["AAS, Computer Science"],
    honors: "Magna Cum Laude",
    gpa: "3.79 / 4.0",
    badge: "Graduated",
    badgeAnimated: false,
  },
];
---

<section id="education" class="education">
  <h2>Education</h2>
  <div class="entries">
    {
      schools.map((s) => (
        <div class="entry">
          <img src={s.logo} alt="" width="52" height="52" class="logo" />
          <div class="entry-body">
            <div class="entry-head">
              <h3>{s.name}</h3>
              <span class="when">{s.when}</span>
            </div>
            {s.lines.map((line) => (
              <p>{line}</p>
            ))}
            {(s.honors || s.gpa) && (
              <p class="meta">
                {s.honors}
                {s.honors && s.gpa && " · "}
                {s.gpa && <strong>GPA {s.gpa}</strong>}
              </p>
            )}
            {s.badge && (
              <span class={s.badgeAnimated ? "badge-shine" : "badge-static"}>
                {s.badge}
              </span>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .education {
    padding-block: 2rem;
    max-width: 40rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-route);
    opacity: 0.55;
    margin: 0 0 1.25rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 1.1rem;
  }

  .logo {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .entry-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0 0 0.25rem;
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.55;
    white-space: nowrap;
    text-align: right;
  }

  p {
    font-size: 1rem;
    line-height: 1.55;
    margin: 0.2rem 0 0;
  }

  .meta {
    font-size: 0.9375rem;
    opacity: 0.85;
  }

  .meta strong {
    font-weight: 700;
    opacity: 1;
  }

  .badge-shine,
  .badge-static {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .badge-static {
    color: var(--color-route);
  }

  .badge-shine {
    color: var(--color-route);
    background-image: linear-gradient(
      100deg,
      var(--color-route) 0%,
      var(--color-route) 40%,
      #8fb3ff 50%,
      var(--color-route) 60%,
      var(--color-route) 100%
    );
    background-size: 300% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 3.5s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
</style>
