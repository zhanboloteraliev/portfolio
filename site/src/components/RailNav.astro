---
const sections = [
  { id: "profile", label: "01 PROFILE" },
  { id: "skills", label: "02 SKILLS" },
  { id: "evidence", label: "03 EVIDENCE" },
  { id: "projects", label: "04 PROJECTS" },
];
---

<nav aria-hidden="true" class="rail">
  <ol>
    {
      sections.map((s, i) => (
        <li style={`--delay:${i}`}>
          <span class="node" />
          <span class="label">{s.label}</span>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .rail {
    display: none;
  }

  @media (min-width: 1024px) {
    .rail {
      display: flex;
      position: fixed;
      left: 2.5rem;
      top: 0;
      height: 100vh;
      flex-direction: column;
      justify-content: center;
      z-index: 10;
      pointer-events: none;
    }
  }

  ol {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  ol::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--color-rule);
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    animation: rail-in 400ms ease-out calc(var(--delay) * 120ms + 500ms) forwards;
  }

  .node {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--color-route);
    background: transparent;
    flex-shrink: 0;
    animation: node-fill 250ms ease-out calc(var(--delay) * 120ms + 650ms) forwards;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    opacity: 0.55;
    white-space: nowrap;
  }

  @keyframes rail-in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes node-fill {
    from {
      background: transparent;
    }
    to {
      background: var(--color-route);
    }
  }
</style>
